# Copy this file to .streamlit/secrets.toml and fill in your real values.
# Get these from your Supabase project: Settings -> API.
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "YOUR-ANON-PUBLIC-KEY"

# Optional: email reminders for digital-asset invoices due within a week.
# Leave these out to show reminders on the portal only.
# Gmail / Google Workspace: SMTP_HOST = "smtp.gmail.com" (needs an App Password)
# Outlook / Microsoft 365:  SMTP_HOST = "smtp.office365.com"
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = 587
# SMTP_USER = "aryaan.pandhare@risify.ai"
# SMTP_PASSWORD = "pass"
# SMTP_FROM = "sender@risify.ai"
# PAYMENT_REMINDER_TO = "aryaan.pandhare@risify.ai"
# COMPLIANCE_REMINDER_TO = "varsha@analahcapital.com"

# Optional: Audit document repository (admin only), stored in Google Drive.
# Get these by running `python scripts/drive_auth.py` once (see README).
# [google_drive]
# client_id = "xxxxxxxx.apps.googleusercontent.com"
# client_secret = "GOCSPX-xxxxxxxx"
# refresh_token = "1//xxxxxxxx"
# root_folder_name = "Risify Audit"   # optional; the top folder in Drive
